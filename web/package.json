{
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "name": "spice-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown -p spice-wasm --manifest-path ../Cargo.toml && wasm-bindgen --target web --out-dir src/wasm/pkg ../target/wasm32-unknown-unknown/release/spice_wasm.wasm",
    "dev": "bun run server.ts",
    "preview": "bun run server.ts --dist",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  }
}
