MOS3 DC: short-channel threshold, weak inversion, velocity saturation, CLM, temperature
vgs g 0 0
vd1 d1 0 3
vd2 d2 0 0.1
vd4 d4 0 -0.5
vbn bn 0 -1
vbf bf 0 0.3
vbp bp 0 -0.4
egp gp 0 g 0 -1
m1 d1 g 0 bn mfull w=10u l=1u
m2 d2 g 0 0 mclm w=10u l=1.2u
m3 d3 gp 0 bp mp w=20u l=1u temp=60 nrd=2 nrs=2
m4 d4 g 0 0 mfull w=10u l=1u
m5 d1 g 0 bf mfull w=4u l=2u m=2
m6 g g 0 bn mvsat w=5u l=0.8u
vd3 d3 0 -2.5
.model mfull nmos(level=3 vto=0.7 tox=20n nsub=1e16 xj=0.25u ld=0.08u uo=550
+ vmax=1.5e5 nfs=2e11 eta=0.4 theta=0.08 kappa=0.5 delta=0.6 gamma=0.6 phi=0.7)
.model mclm nmos(level=3 tox=25n nsub=2e16 tpg=1 nss=1e10 xj=0.3u u0=500 eta=0.2
+ theta=0.05 kappa=0.4 tnom=20 delvto=0.05)
.model mp pmos(level=3 vto=-0.8 tox=20n nsub=1.5e16 xj=0.2u ld=0.06u xl=-0.05u wd=0.1u xw=0.05u
+ u0=220 vmax=1e5 nfs=1e11 eta=0.3 theta=0.1 kappa=0.6 delta=0.4 rd=20 rsh=15)
.model mvsat nmos(level=3 vto=0.6 kp=80u gamma=0.4 phi=0.65 tox=15n vmax=8e4 theta=0.1
+ eta=0.15 xj=0.2u nsub=3e16 kappa=0.3)
.options reltol=1e-7 vntol=1e-12 abstol=1e-18
.dc vgs 0 4 0.05
.end
