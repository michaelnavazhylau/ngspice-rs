//! Rust port of Kenneth Kundert's SPARSE 1.3, ngspice's native sparse LU.
//!
//! C: `src/maths/sparse/` (`spbuild.c`, `spfactor.c`, `spsolve.c`,
//! `sputils.c`), driven through `spsmp.c`. SPARSE is distributed under the
//! permissive Berkeley notice reproduced in its headers ("Permission to use,
//! copy, modify, and distribute this software ... provided that the copyright
//! notices appear in all copies"), so unlike KLU it may be ported here:
//!
//! > Copyright (c) 1985,86,87,88,89,90 by Kenneth S. Kundert and the
//! > University of California.
//!
//! The configuration matches ngspice's `spconfig.h`: `TRANSLATE`,
//! `EXPANDABLE` (sizes are fixed up front here), `DIAGONAL_PIVOTING`,
//! `MODIFIED_NODAL`, `TRANSPOSE`, `DETERMINANT`; no `MODIFIED_MARKOWITZ`,
//! scaling or condition estimation. The default relative threshold is
//! `1e-3` and `TIES_MULTIPLIER` 5 (`MAX_MARKOWITZ_TIES` only applies to
//! `MODIFIED_MARKOWITZ`).
//!
//! The orthogonal linked lists of C pointers become an element arena with
//! index links; a C `ElementPtr *` "address of a link" is a [`Slot`]. The
//! control flow of every routine follows the C function of the same name,
//! including the order of pivot candidates, tie breaking and fill-in creation,
//! so pivot sequences match SPARSE for the same element creation order.
//! Divergences: the factor loop always uses the direct (scatter/gather)
//! variant of `spFactor`, which performs the same arithmetic as the indirect
//! one; and `SearchForSingleton` stops on a structurally missing diagonal,
//! which is where ngspice's version either breaks or dereferences `NULL`.

use crate::primitives::Complex;

const NONE: usize = usize::MAX;
const DEFAULT_THRESHOLD: f64 = 1.0e-3;
const TIES_MULTIPLIER: i64 = 5;

/// Matrix entry type: `f64` for real systems, [`Complex`] for AC.
pub(crate) trait Scalar: Copy + PartialEq + std::fmt::Debug {
    /// Additive identity.
    const ZERO: Self;
    /// C `ELEMENT_MAG`: `|re| + |im|`.
    fn mag(self) -> f64;
    /// Real part, used by `CountTwins`' `ABS(Real) == 1.0` test.
    fn real(self) -> f64;
    /// C `1.0 / x` or `CMPLX_RECIPROCAL`.
    fn recip(self) -> Self;
    /// C `x * y` or `CMPLX_MULT`.
    fn mul(self, other: Self) -> Self;
    /// C `to -= a * b` or `CMPLX_MULT_SUBT_ASSIGN(to, a, b)`.
    fn mul_sub(self, a: Self, b: Self) -> Self;
    /// Whether the value is exactly zero (`== 0.0` on every part).
    fn is_zero(self) -> bool;
}

impl Scalar for f64 {
    const ZERO: Self = 0.0;
    fn mag(self) -> f64 {
        self.abs()
    }
    fn real(self) -> f64 {
        self
    }
    fn recip(self) -> Self {
        1.0 / self
    }
    fn mul(self, other: Self) -> Self {
        self * other
    }
    fn mul_sub(self, a: Self, b: Self) -> Self {
        self - a * b
    }
    fn is_zero(self) -> bool {
        self == 0.0
    }
}

impl Scalar for Complex {
    const ZERO: Self = Complex::ZERO;
    fn mag(self) -> f64 {
        self.re.abs() + self.im.abs()
    }
    fn real(self) -> f64 {
        self.re
    }
    fn recip(self) -> Self {
        // CMPLX_RECIPROCAL (spdefs.h).
        let den = self;
        if (den.re >= den.im && den.re > -den.im) || (den.re < den.im && den.re <= -den.im) {
            let r = den.im / den.re;
            let re = 1.0 / (den.re + r * den.im);
            Complex::new(re, -r * re)
        } else {
            let r = den.re / den.im;
            let im = -1.0 / (den.im + r * den.re);
            Complex::new(-r * im, im)
        }
    }
    fn mul(self, b: Self) -> Self {
        Complex::new(
            self.re * b.re - self.im * b.im,
            self.re * b.im + self.im * b.re,
        )
    }
    fn mul_sub(self, a: Self, b: Self) -> Self {
        Complex::new(
            self.re - (a.re * b.re - a.im * b.im),
            self.im - (a.re * b.im + a.im * b.re),
        )
    }
    fn is_zero(self) -> bool {
        self.re == 0.0 && self.im == 0.0
    }
}

/// SPARSE's error state (`spOKAY`, `spSMALL_PIVOT`, `spZERO_DIAG`,
/// `spSINGULAR`). ngspice maps `spSMALL_PIVOT` to `OK`.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub(crate) enum Status {
    Okay,
    SmallPivot,
    ZeroDiag,
    Singular,
}

#[derive(Debug, Clone)]
struct Element<T> {
    value: T,
    row: usize,
    col: usize,
    next_in_row: usize,
    next_in_col: usize,
}

/// The address of a column (or row) link: a list head or an element's link.
#[derive(Debug, Clone, Copy)]
enum Slot {
    Head(usize),
    After(usize),
}

/// A SPARSE matrix frame (`struct MatrixFrame`) with 1-based internal and
/// external indices; external index 0 (ground) is never used here.
#[derive(Debug, Clone)]
pub(crate) struct Sparse<T> {
    size: usize,
    current_size: usize,
    elements: Vec<Element<T>>,
    diag: Vec<usize>,
    first_in_col: Vec<usize>,
    first_in_row: Vec<usize>,
    ext_to_int_row: Vec<usize>,
    ext_to_int_col: Vec<usize>,
    int_to_ext_row: Vec<usize>,
    int_to_ext_col: Vec<usize>,
    markowitz_row: Vec<i64>,
    markowitz_col: Vec<i64>,
    markowitz_prod: Vec<i64>,
    singletons: i64,
    rel_threshold: f64,
    abs_threshold: f64,
    rows_linked: bool,
    internal_vectors: bool,
    needs_ordering: bool,
    factored: bool,
    interchanges_odd: bool,
    status: Status,
    singular_row: usize,
    singular_col: usize,
}

impl<T: Scalar> Sparse<T> {
    /// `spCreate(size)`.
    pub(crate) fn new(size: usize) -> Self {
        let mut ext_to_int = vec![NONE; size + 1];
        ext_to_int[0] = 0;
        Self {
            size,
            current_size: 0,
            elements: Vec::new(),
            diag: vec![NONE; size + 1],
            first_in_col: vec![NONE; size + 1],
            first_in_row: vec![NONE; size + 1],
            ext_to_int_row: ext_to_int.clone(),
            ext_to_int_col: ext_to_int,
            int_to_ext_row: (0..=size).collect(),
            int_to_ext_col: (0..=size).collect(),
            markowitz_row: Vec::new(),
            markowitz_col: Vec::new(),
            markowitz_prod: Vec::new(),
            singletons: 0,
            rel_threshold: DEFAULT_THRESHOLD,
            abs_threshold: 0.0,
            rows_linked: false,
            internal_vectors: false,
            needs_ordering: true,
            factored: false,
            interchanges_odd: false,
            status: Status::Okay,
            singular_row: 0,
            singular_col: 0,
        }
    }

    /// Whether every external index has been translated (no empty unknown).
    pub(crate) fn fully_translated(&self) -> bool {
        self.current_size == self.size
    }

    /// External row and column of the last singular/zero pivot.
    pub(crate) fn where_singular(&self) -> (usize, usize) {
        (self.singular_row, self.singular_col)
    }

    fn col_get(&self, slot: Slot) -> usize {
        match slot {
            Slot::Head(col) => self.first_in_col[col],
            Slot::After(e) => self.elements[e].next_in_col,
        }
    }
    fn col_set(&mut self, slot: Slot, value: usize) {
        match slot {
            Slot::Head(col) => self.first_in_col[col] = value,
            Slot::After(e) => self.elements[e].next_in_col = value,
        }
    }
    fn row_get(&self, slot: Slot) -> usize {
        match slot {
            Slot::Head(row) => self.first_in_row[row],
            Slot::After(e) => self.elements[e].next_in_row,
        }
    }
    fn row_set(&mut self, slot: Slot, value: usize) {
        match slot {
            Slot::Head(row) => self.first_in_row[row] = value,
            Slot::After(e) => self.elements[e].next_in_row = value,
        }
    }
    fn mag(&self, e: usize) -> f64 {
        self.elements[e].value.mag()
    }

    // --- spbuild.c ------------------------------------------------------

    /// `spGetElement(ext_row, ext_col)`: the element handle, created if
    /// missing. Indices are external and 1-based.
    pub(crate) fn get_element(&mut self, row: usize, col: usize) -> usize {
        debug_assert!(row >= 1 && col >= 1 && row <= self.size && col <= self.size);
        let (row, col) = self.translate(row, col);
        if row == col && self.diag[row] != NONE {
            return self.diag[row];
        }
        self.find_element_in_col(Slot::Head(col), row, col, true)
    }

    /// Adds to an element obtained from [`Self::get_element`].
    #[cfg(test)]
    pub(crate) fn add(&mut self, element: usize, value: T)
    where
        T: std::ops::Add<Output = T>,
    {
        let v = &mut self.elements[element].value;
        *v = *v + value;
    }

    /// `Translate`: assigns internal indices in first-reference order.
    fn translate(&mut self, ext_row: usize, ext_col: usize) -> (usize, usize) {
        let mut int_row = self.ext_to_int_row[ext_row];
        if int_row == NONE {
            self.current_size += 1;
            int_row = self.current_size;
            self.ext_to_int_row[ext_row] = int_row;
            self.ext_to_int_col[ext_row] = int_row;
            self.int_to_ext_row[int_row] = ext_row;
            self.int_to_ext_col[int_row] = ext_row;
        }
        let mut int_col = self.ext_to_int_col[ext_col];
        if int_col == NONE {
            self.current_size += 1;
            int_col = self.current_size;
            self.ext_to_int_row[ext_col] = int_col;
            self.ext_to_int_col[ext_col] = int_col;
            self.int_to_ext_row[int_col] = ext_col;
            self.int_to_ext_col[int_col] = ext_col;
        }
        (int_row, int_col)
    }

    /// `spcFindElementInCol`.
    fn find_element_in_col(
        &mut self,
        mut last: Slot,
        row: usize,
        col: usize,
        create: bool,
    ) -> usize {
        let mut e = self.col_get(last);
        while e != NONE {
            let r = self.elements[e].row;
            if r < row {
                last = Slot::After(e);
                e = self.elements[e].next_in_col;
            } else if r == row {
                return e;
            } else {
                break;
            }
        }
        if create {
            self.create_element(row, col, last, false)
        } else {
            NONE
        }
    }

    /// `spcCreateElement`.
    fn create_element(&mut self, row: usize, col: usize, last: Slot, fillin: bool) -> usize {
        let e = self.elements.len();
        self.elements.push(Element {
            value: T::ZERO,
            row,
            col,
            next_in_row: NONE,
            next_in_col: self.col_get(last),
        });
        if row == col {
            self.diag[row] = e;
        }
        self.col_set(last, e);
        if self.rows_linked {
            if !fillin {
                self.needs_ordering = true;
            }
            let mut previous = NONE;
            let mut p = self.first_in_row[row];
            while p != NONE && self.elements[p].col < col {
                previous = p;
                p = self.elements[p].next_in_row;
            }
            if previous == NONE {
                self.elements[e].next_in_row = self.first_in_row[row];
                self.first_in_row[row] = e;
            } else {
                self.elements[e].next_in_row = self.elements[previous].next_in_row;
                self.elements[previous].next_in_row = e;
            }
        }
        e
    }

    /// `spcLinkRows`.
    fn link_rows(&mut self) {
        for col in (1..=self.size).rev() {
            let mut e = self.first_in_col[col];
            while e != NONE {
                let row = self.elements[e].row;
                self.elements[e].col = col;
                self.elements[e].next_in_row = self.first_in_row[row];
                self.first_in_row[row] = e;
                e = self.elements[e].next_in_col;
            }
        }
        self.rows_linked = true;
    }

    /// `spClear`: zero every value, keeping structure and pivot order.
    pub(crate) fn clear(&mut self) {
        for element in &mut self.elements {
            element.value = T::ZERO;
        }
        self.status = Status::Okay;
        self.factored = false;
        self.singular_row = 0;
        self.singular_col = 0;
    }

    /// The same matrix frame holding another scalar type, every element
    /// zero: ngspice switches one frame between real and complex
    /// (`spSetReal`/`spSetComplex`), keeping its internal numbering, row and
    /// column exchanges, pivot order, fill-ins and flags. Loads start with
    /// `spClear`, so the values carried over do not matter.
    pub(crate) fn retyped<U: Scalar>(&self) -> Sparse<U> {
        Sparse {
            size: self.size,
            current_size: self.current_size,
            elements: self
                .elements
                .iter()
                .map(|e| Element {
                    value: U::ZERO,
                    row: e.row,
                    col: e.col,
                    next_in_row: e.next_in_row,
                    next_in_col: e.next_in_col,
                })
                .collect(),
            diag: self.diag.clone(),
            first_in_col: self.first_in_col.clone(),
            first_in_row: self.first_in_row.clone(),
            ext_to_int_row: self.ext_to_int_row.clone(),
            ext_to_int_col: self.ext_to_int_col.clone(),
            int_to_ext_row: self.int_to_ext_row.clone(),
            int_to_ext_col: self.int_to_ext_col.clone(),
            markowitz_row: self.markowitz_row.clone(),
            markowitz_col: self.markowitz_col.clone(),
            markowitz_prod: self.markowitz_prod.clone(),
            singletons: self.singletons,
            rel_threshold: self.rel_threshold,
            abs_threshold: self.abs_threshold,
            rows_linked: self.rows_linked,
            internal_vectors: self.internal_vectors,
            needs_ordering: self.needs_ordering,
            factored: self.factored,
            interchanges_odd: self.interchanges_odd,
            status: self.status,
            singular_row: self.singular_row,
            singular_col: self.singular_col,
        }
    }

    /// Overwrites one element's value (`*element = value`).
    pub(crate) fn set(&mut self, element: usize, value: T) {
        self.elements[element].value = value;
    }

    // --- sputils.c ------------------------------------------------------

    /// `spMNA_Preorder`: swap columns so structural `±1` twins from voltage
    /// sources land on the diagonal before ordering.
    pub(crate) fn mna_preorder(&mut self) {
        if self.rows_linked {
            return;
        }
        let size = self.size;
        let mut start_at = 1;
        loop {
            let mut another_pass = false;
            let mut swapped = false;
            // C's `StartAt` changes only take effect on the next pass.
            #[allow(clippy::mut_range_bound)]
            for j in start_at..=size {
                if self.diag[j] == NONE {
                    let (twins, t1, t2) = self.count_twins(j);
                    if twins == 1 {
                        self.swap_cols(t1, t2);
                        swapped = true;
                    } else if twins > 1 && !another_pass {
                        another_pass = true;
                        start_at = j;
                    }
                }
            }
            if another_pass {
                let mut j = start_at;
                while !swapped && j <= size {
                    if self.diag[j] == NONE {
                        let (_, t1, t2) = self.count_twins(j);
                        self.swap_cols(t1, t2);
                        swapped = true;
                    }
                    j += 1;
                }
            }
            if !another_pass {
                break;
            }
        }
    }

    /// `CountTwins`: the twin pair found is the last one before a second.
    fn count_twins(&mut self, col: usize) -> (usize, usize, usize) {
        let mut twins = 0;
        let (mut out1, mut out2) = (NONE, NONE);
        let mut t1 = self.first_in_col[col];
        while t1 != NONE {
            if self.elements[t1].value.real().abs() == 1.0 {
                let row = self.elements[t1].row;
                let mut t2 = self.first_in_col[row];
                while t2 != NONE && self.elements[t2].row != col {
                    t2 = self.elements[t2].next_in_col;
                }
                if t2 != NONE && self.elements[t2].value.real().abs() == 1.0 {
                    twins += 1;
                    if twins >= 2 {
                        return (twins, out1, out2);
                    }
                    self.elements[t1].col = col;
                    self.elements[t2].col = row;
                    out1 = t1;
                    out2 = t2;
                }
            }
            t1 = self.elements[t1].next_in_col;
        }
        (twins, out1, out2)
    }

    /// `SwapCols`.
    fn swap_cols(&mut self, t1: usize, t2: usize) {
        let (c1, c2) = (self.elements[t1].col, self.elements[t2].col);
        self.first_in_col.swap(c1, c2);
        self.int_to_ext_col.swap(c1, c2);
        self.ext_to_int_col[self.int_to_ext_col[c2]] = c2;
        self.ext_to_int_col[self.int_to_ext_col[c1]] = c1;
        self.diag[c1] = t2;
        self.diag[c2] = t1;
        self.interchanges_odd = !self.interchanges_odd;
    }

    /// `spDeterminant`: `(mantissa, exponent)` with `1 <= |mantissa| < 10`
    /// in C's `max(|re|, |im|)` norm, or zero after a singular ordering.
    pub(crate) fn determinant(&self) -> (T, i32)
    where
        T: DeterminantScale,
    {
        let mut exponent = 0;
        if self.status == Status::Singular {
            return (T::ZERO, 0);
        }
        let mut det = T::one();
        for i in 1..=self.size {
            det = T::det_step(det, self.elements[self.diag[i]].value);
            let mut norm = det.norm();
            if norm != 0.0 {
                while norm >= 1.0e12 {
                    det = det.scale(1.0e-12);
                    exponent += 12;
                    norm = det.norm();
                }
                while norm < 1.0e-12 {
                    det = det.scale(1.0e12);
                    exponent -= 12;
                    norm = det.norm();
                }
            }
        }
        let mut norm = det.norm();
        if norm != 0.0 {
            while norm >= 10.0 {
                det = det.scale(0.1);
                exponent += 1;
                norm = det.norm();
            }
            while norm < 1.0 {
                det = det.scale(10.0);
                exponent -= 1;
                norm = det.norm();
            }
        }
        if self.interchanges_odd {
            det = det.scale(-1.0);
        }
        (det, exponent)
    }

    // --- spfactor.c -----------------------------------------------------

    /// `spOrderAndFactor(Matrix, NULL, rel, abs, DiagPivoting = YES)`.
    pub(crate) fn order_and_factor(&mut self, rel_threshold: f64, abs_threshold: f64) -> Status {
        self.status = Status::Okay;
        let size = self.size;
        if rel_threshold > 0.0 && rel_threshold <= 1.0 {
            self.rel_threshold = rel_threshold;
        }
        if abs_threshold >= 0.0 {
            self.abs_threshold = abs_threshold;
        }
        let mut step = 1;
        let mut reorder = false;
        if !self.needs_ordering {
            while step <= size {
                let pivot = self.diag[step];
                if pivot == NONE {
                    reorder = true;
                    break;
                }
                let largest = self.find_largest_in_col(self.elements[pivot].next_in_col);
                if largest * self.rel_threshold < self.mag(pivot) {
                    self.row_col_elimination(pivot);
                } else {
                    reorder = true;
                    break;
                }
                step += 1;
            }
            if !reorder {
                return self.done();
            }
        } else {
            if !self.rows_linked {
                self.link_rows();
            }
            if !self.internal_vectors {
                self.create_internal_vectors();
            }
        }
        self.count_markowitz(step);
        self.markowitz_products(step);
        while step <= size {
            let Some(pivot) = self.search_for_pivot(step) else {
                return self.matrix_is_singular(step);
            };
            self.exchange_rows_and_cols(pivot, step);
            self.row_col_elimination(pivot);
            if self.status == Status::Singular {
                return self.status;
            }
            self.update_markowitz_numbers(pivot);
            step += 1;
        }
        self.done()
    }

    fn done(&mut self) -> Status {
        self.needs_ordering = false;
        self.factored = true;
        self.status
    }

    /// `spFactor`: refactor with the existing pivot order (no threshold test).
    pub(crate) fn factor(&mut self) -> Status {
        if self.needs_ordering {
            return self.order_and_factor(0.0, 0.0);
        }
        let size = self.size;
        if size == 0 {
            self.factored = true;
            self.status = Status::Okay;
            return self.status;
        }
        let first = self.diag[1];
        if self.elements[first].value.is_zero() {
            return self.zero_pivot(1);
        }
        self.elements[first].value = self.elements[first].value.recip();
        let mut dest = vec![T::ZERO; size + 1];
        for step in 2..=size {
            let mut e = self.first_in_col[step];
            while e != NONE {
                dest[self.elements[e].row] = self.elements[e].value;
                e = self.elements[e].next_in_col;
            }
            let mut column = self.first_in_col[step];
            while self.elements[column].row < step {
                let row = self.elements[column].row;
                let mut e = self.diag[row];
                let mult = dest[row].mul(self.elements[e].value);
                self.elements[column].value = mult;
                e = self.elements[e].next_in_col;
                while e != NONE {
                    let r = self.elements[e].row;
                    dest[r] = dest[r].mul_sub(mult, self.elements[e].value);
                    e = self.elements[e].next_in_col;
                }
                column = self.elements[column].next_in_col;
            }
            let mut e = self.elements[self.diag[step]].next_in_col;
            while e != NONE {
                self.elements[e].value = dest[self.elements[e].row];
                e = self.elements[e].next_in_col;
            }
            if dest[step].is_zero() {
                return self.zero_pivot(step);
            }
            let d = self.diag[step];
            self.elements[d].value = dest[step].recip();
        }
        self.factored = true;
        self.status = Status::Okay;
        self.status
    }

    /// `spcCreateInternalVectors`.
    fn create_internal_vectors(&mut self) {
        let size = self.size;
        self.markowitz_row = vec![0; size + 1];
        self.markowitz_col = vec![0; size + 1];
        self.markowitz_prod = vec![0; size + 2];
        self.internal_vectors = true;
    }

    /// `CountMarkowitz` (no RHS).
    fn count_markowitz(&mut self, step: usize) {
        for i in step..=self.size {
            let mut count = -1;
            let mut e = self.first_in_row[i];
            while e != NONE && self.elements[e].col < step {
                e = self.elements[e].next_in_row;
            }
            while e != NONE {
                count += 1;
                e = self.elements[e].next_in_row;
            }
            self.markowitz_row[i] = count;
        }
        for i in step..=self.size {
            let mut count = -1;
            let mut e = self.first_in_col[i];
            while e != NONE && self.elements[e].row < step {
                e = self.elements[e].next_in_col;
            }
            while e != NONE {
                count += 1;
                e = self.elements[e].next_in_col;
            }
            self.markowitz_col[i] = count;
        }
    }

    /// `MarkowitzProducts`.
    fn markowitz_products(&mut self, step: usize) {
        self.singletons = 0;
        for i in step..=self.size {
            let product = self.markowitz_row[i].saturating_mul(self.markowitz_col[i]);
            self.markowitz_prod[i] = product;
            if product == 0 {
                self.singletons += 1;
            }
        }
    }

    /// `SearchForPivot` with diagonal pivoting.
    fn search_for_pivot(&mut self, step: usize) -> Option<usize> {
        if self.singletons != 0
            && let Some(pivot) = self.search_for_singleton(step)
        {
            return Some(pivot);
        }
        if let Some(pivot) = self.quickly_search_diagonal(step) {
            return Some(pivot);
        }
        if let Some(pivot) = self.search_diagonal(step) {
            return Some(pivot);
        }
        self.search_entire_matrix(step)
    }

    fn acceptable(&self, pivot: usize, step: usize) -> bool {
        let mag = self.mag(pivot);
        mag > self.abs_threshold
            && mag > self.rel_threshold * self.find_biggest_in_col_exclude(pivot, step)
    }

    /// `SearchForSingleton`.
    fn search_for_singleton(&mut self, step: usize) -> Option<usize> {
        let size = self.size;
        self.markowitz_prod[size + 1] = self.markowitz_prod[step];
        let mut singletons = self.singletons;
        self.singletons -= 1;
        self.markowitz_prod[step - 1] = 0;
        // `p` is C's `pMarkowitzProduct - MarkowitzProd`; it can reach -1.
        let mut p = (size + 1) as isize;
        while singletons > 0 {
            singletons -= 1;
            loop {
                let value = self.markowitz_prod[p as usize];
                p -= 1;
                if value == 0 {
                    break;
                }
            }
            let mut i = (p + 1) as usize;
            if i < step {
                break;
            }
            if i > size {
                i = step;
            }
            let diag = self.diag[i];
            if diag == NONE {
                // ngspice's off-diagonal singleton branches `break` (or would
                // dereference NULL) when no diagonal exists.
                break;
            }
            if self.acceptable(diag, step) {
                return Some(diag);
            }
        }
        self.singletons += 1;
        None
    }

    /// `QuicklySearchDiagonal` (without `MODIFIED_MARKOWITZ`).
    fn quickly_search_diagonal(&mut self, step: usize) -> Option<usize> {
        let size = self.size;
        let mut chosen = NONE;
        let mut min = i64::MAX;
        self.markowitz_prod[size + 1] = self.markowitz_prod[step];
        self.markowitz_prod[step - 1] = -1;
        let mut p = size + 2;
        loop {
            loop {
                p -= 1;
                if self.markowitz_prod[p] < min {
                    break;
                }
            }
            let mut i = p;
            if i < step {
                break;
            }
            if i > size {
                i = step;
            }
            let diag = self.diag[i];
            if diag == NONE {
                continue;
            }
            let magnitude = self.mag(diag);
            if magnitude <= self.abs_threshold {
                continue;
            }
            if self.markowitz_prod[p] == 1 {
                let mut other_row = self.elements[diag].next_in_row;
                let mut other_col = self.elements[diag].next_in_col;
                if other_row == NONE && other_col == NONE {
                    other_row = self.first_in_row[i];
                    while other_row != NONE {
                        let c = self.elements[other_row].col;
                        if c >= step && c != i {
                            break;
                        }
                        other_row = self.elements[other_row].next_in_row;
                    }
                    other_col = self.first_in_col[i];
                    while other_col != NONE {
                        let r = self.elements[other_col].row;
                        if r >= step && r != i {
                            break;
                        }
                        other_col = self.elements[other_col].next_in_col;
                    }
                }
                if other_row != NONE
                    && other_col != NONE
                    && self.elements[other_row].col == self.elements[other_col].row
                {
                    let largest_off = self.mag(other_row).max(self.mag(other_col));
                    if magnitude >= largest_off {
                        return Some(diag);
                    }
                }
            }
            min = self.markowitz_prod[p];
            chosen = diag;
        }
        if chosen != NONE {
            let largest = self.find_biggest_in_col_exclude(chosen, step);
            if self.mag(chosen) <= self.rel_threshold * largest {
                return None;
            }
            return Some(chosen);
        }
        None
    }

    /// `SearchDiagonal`.
    fn search_diagonal(&mut self, step: usize) -> Option<usize> {
        let size = self.size;
        let mut chosen = NONE;
        let mut min = i64::MAX;
        let mut ties = 0;
        let mut accepted_ratio = 0.0;
        self.markowitz_prod[size + 1] = self.markowitz_prod[step];
        for j in (step + 1..=size + 1).rev() {
            let product = self.markowitz_prod[j];
            if product > min {
                continue;
            }
            let i = if j > size { step } else { j };
            let diag = self.diag[i];
            if diag == NONE {
                continue;
            }
            let magnitude = self.mag(diag);
            if magnitude <= self.abs_threshold {
                continue;
            }
            let largest = self.find_biggest_in_col_exclude(diag, step);
            if magnitude <= self.rel_threshold * largest {
                continue;
            }
            if product < min {
                chosen = diag;
                min = product;
                accepted_ratio = largest / magnitude;
                ties = 0;
            } else {
                ties += 1;
                let ratio = largest / magnitude;
                if ratio < accepted_ratio {
                    chosen = diag;
                    accepted_ratio = ratio;
                }
                if ties >= min.saturating_mul(TIES_MULTIPLIER) {
                    return Some(chosen);
                }
            }
        }
        (chosen != NONE).then_some(chosen)
    }

    /// `SearchEntireMatrix`. Sets `SmallPivot`/`Singular` like C.
    fn search_entire_matrix(&mut self, step: usize) -> Option<usize> {
        let mut chosen = NONE;
        let mut largest_element = NONE;
        let mut largest_mag = 0.0;
        let mut min = i64::MAX;
        let mut ties = 0;
        let mut accepted_ratio = 0.0;
        for i in step..=self.size {
            let mut e = self.first_in_col[i];
            while e != NONE && self.elements[e].row < step {
                e = self.elements[e].next_in_col;
            }
            let largest_in_col = self.find_largest_in_col(e);
            if largest_in_col == 0.0 {
                continue;
            }
            while e != NONE {
                let magnitude = self.mag(e);
                if magnitude > largest_mag {
                    largest_mag = magnitude;
                    largest_element = e;
                }
                let element = &self.elements[e];
                let product =
                    self.markowitz_row[element.row].saturating_mul(self.markowitz_col[element.col]);
                if product <= min
                    && magnitude > self.rel_threshold * largest_in_col
                    && magnitude > self.abs_threshold
                {
                    if product < min {
                        chosen = e;
                        min = product;
                        accepted_ratio = largest_in_col / magnitude;
                        ties = 0;
                    } else {
                        ties += 1;
                        let ratio = largest_in_col / magnitude;
                        if ratio < accepted_ratio {
                            chosen = e;
                            accepted_ratio = ratio;
                        }
                        if ties >= min.saturating_mul(TIES_MULTIPLIER) {
                            return Some(chosen);
                        }
                    }
                }
                e = self.elements[e].next_in_col;
            }
        }
        if chosen != NONE {
            return Some(chosen);
        }
        if largest_mag == 0.0 {
            self.status = Status::Singular;
            return None;
        }
        self.status = Status::SmallPivot;
        Some(largest_element)
    }

    /// `FindLargestInCol` from `e` downwards.
    fn find_largest_in_col(&self, mut e: usize) -> f64 {
        let mut largest = 0.0;
        while e != NONE {
            let magnitude = self.mag(e);
            if magnitude > largest {
                largest = magnitude;
            }
            e = self.elements[e].next_in_col;
        }
        largest
    }

    /// `FindBiggestInColExclude`.
    fn find_biggest_in_col_exclude(&self, pivot: usize, step: usize) -> f64 {
        let row = self.elements[pivot].row;
        let col = self.elements[pivot].col;
        let mut e = self.first_in_col[col];
        while e != NONE && self.elements[e].row < step {
            e = self.elements[e].next_in_col;
        }
        let mut largest = if self.elements[e].row != row {
            self.mag(e)
        } else {
            0.0
        };
        e = self.elements[e].next_in_col;
        while e != NONE {
            let magnitude = self.mag(e);
            if magnitude > largest && self.elements[e].row != row {
                largest = magnitude;
            }
            e = self.elements[e].next_in_col;
        }
        largest
    }

    fn product_of(&self, i: usize) -> i64 {
        self.markowitz_row[i].saturating_mul(self.markowitz_col[i])
    }

    fn track_singleton(&mut self, new: i64, old: i64) {
        if (new == 0) != (old == 0) {
            if old == 0 {
                self.singletons -= 1;
            } else {
                self.singletons += 1;
            }
        }
    }

    /// `ExchangeRowsAndCols`.
    fn exchange_rows_and_cols(&mut self, pivot: usize, step: usize) {
        let row = self.elements[pivot].row;
        let col = self.elements[pivot].col;
        if row == step && col == step {
            return;
        }
        if row == col {
            self.row_exchange(step, row);
            self.col_exchange(step, col);
            self.markowitz_prod.swap(step, row);
            self.diag.swap(row, step);
        } else {
            let old_step = self.markowitz_prod[step];
            let old_row = self.markowitz_prod[row];
            let old_col = self.markowitz_prod[col];
            if row != step {
                self.row_exchange(step, row);
                self.interchanges_odd = !self.interchanges_odd;
                self.markowitz_prod[row] = self.product_of(row);
                self.track_singleton(self.markowitz_prod[row], old_row);
            }
            if col != step {
                self.col_exchange(step, col);
                self.interchanges_odd = !self.interchanges_odd;
                self.markowitz_prod[col] = self.product_of(col);
                self.track_singleton(self.markowitz_prod[col], old_col);
                self.diag[col] = self.find_element_in_col(Slot::Head(col), col, col, false);
            }
            if row != step {
                self.diag[row] = self.find_element_in_col(Slot::Head(row), row, row, false);
            }
            self.diag[step] = self.find_element_in_col(Slot::Head(step), step, step, false);
            self.markowitz_prod[step] = self.product_of(step);
            self.track_singleton(self.markowitz_prod[step], old_step);
        }
    }

    /// `spcRowExchange`.
    fn row_exchange(&mut self, mut row1: usize, mut row2: usize) {
        if row1 > row2 {
            std::mem::swap(&mut row1, &mut row2);
        }
        let mut p1 = self.first_in_row[row1];
        let mut p2 = self.first_in_row[row2];
        while p1 != NONE || p2 != NONE {
            let (column, e1, e2);
            if p1 == NONE {
                column = self.elements[p2].col;
                (e1, e2) = (NONE, p2);
                p2 = self.elements[p2].next_in_row;
            } else if p2 == NONE || self.elements[p1].col < self.elements[p2].col {
                column = self.elements[p1].col;
                (e1, e2) = (p1, NONE);
                p1 = self.elements[p1].next_in_row;
            } else if self.elements[p1].col > self.elements[p2].col {
                column = self.elements[p2].col;
                (e1, e2) = (NONE, p2);
                p2 = self.elements[p2].next_in_row;
            } else {
                column = self.elements[p1].col;
                (e1, e2) = (p1, p2);
                p1 = self.elements[p1].next_in_row;
                p2 = self.elements[p2].next_in_row;
            }
            self.exchange_col_elements(row1, e1, row2, e2, column);
        }
        if self.internal_vectors {
            self.markowitz_row.swap(row1, row2);
        }
        self.first_in_row.swap(row1, row2);
        self.int_to_ext_row.swap(row1, row2);
        self.ext_to_int_row[self.int_to_ext_row[row1]] = row1;
        self.ext_to_int_row[self.int_to_ext_row[row2]] = row2;
    }

    /// `spcColExchange`.
    fn col_exchange(&mut self, mut col1: usize, mut col2: usize) {
        if col1 > col2 {
            std::mem::swap(&mut col1, &mut col2);
        }
        let mut p1 = self.first_in_col[col1];
        let mut p2 = self.first_in_col[col2];
        while p1 != NONE || p2 != NONE {
            let (row, e1, e2);
            if p1 == NONE {
                row = self.elements[p2].row;
                (e1, e2) = (NONE, p2);
                p2 = self.elements[p2].next_in_col;
            } else if p2 == NONE || self.elements[p1].row < self.elements[p2].row {
                row = self.elements[p1].row;
                (e1, e2) = (p1, NONE);
                p1 = self.elements[p1].next_in_col;
            } else if self.elements[p1].row > self.elements[p2].row {
                row = self.elements[p2].row;
                (e1, e2) = (NONE, p2);
                p2 = self.elements[p2].next_in_col;
            } else {
                row = self.elements[p1].row;
                (e1, e2) = (p1, p2);
                p1 = self.elements[p1].next_in_col;
                p2 = self.elements[p2].next_in_col;
            }
            self.exchange_row_elements(col1, e1, col2, e2, row);
        }
        if self.internal_vectors {
            self.markowitz_col.swap(col1, col2);
        }
        self.first_in_col.swap(col1, col2);
        self.int_to_ext_col.swap(col1, col2);
        self.ext_to_int_col[self.int_to_ext_col[col1]] = col1;
        self.ext_to_int_col[self.int_to_ext_col[col2]] = col2;
    }

    /// `ExchangeColElements`: move `e1`/`e2` between rows `row1 < row2` of
    /// one column's list.
    fn exchange_col_elements(
        &mut self,
        row1: usize,
        e1: usize,
        row2: usize,
        e2: usize,
        column: usize,
    ) {
        let mut above1 = Slot::Head(column);
        let mut p = self.col_get(above1);
        while self.elements[p].row < row1 {
            above1 = Slot::After(p);
            p = self.col_get(above1);
        }
        if e1 != NONE {
            let below1 = self.elements[e1].next_in_col;
            if e2 == NONE {
                if below1 != NONE && self.elements[below1].row < row2 {
                    self.col_set(above1, below1);
                    let mut p = below1;
                    let mut above2;
                    loop {
                        above2 = Slot::After(p);
                        p = self.col_get(above2);
                        if !(p != NONE && self.elements[p].row < row2) {
                            break;
                        }
                    }
                    self.col_set(above2, e1);
                    self.elements[e1].next_in_col = p;
                    self.col_set(above1, below1);
                }
                self.elements[e1].row = row2;
            } else {
                if self.elements[below1].row == row2 {
                    self.elements[e1].next_in_col = self.elements[e2].next_in_col;
                    self.elements[e2].next_in_col = e1;
                    self.col_set(above1, e2);
                } else {
                    let mut p = below1;
                    let mut above2;
                    loop {
                        above2 = Slot::After(p);
                        p = self.col_get(above2);
                        if self.elements[p].row >= row2 {
                            break;
                        }
                    }
                    let below2 = self.elements[e2].next_in_col;
                    self.col_set(above1, e2);
                    self.elements[e2].next_in_col = below1;
                    self.col_set(above2, e1);
                    self.elements[e1].next_in_col = below2;
                }
                self.elements[e1].row = row2;
                self.elements[e2].row = row1;
            }
        } else {
            let below1 = p;
            if self.elements[below1].row != row2 {
                let mut above2;
                loop {
                    above2 = Slot::After(p);
                    p = self.col_get(above2);
                    if self.elements[p].row >= row2 {
                        break;
                    }
                }
                let below2 = self.elements[e2].next_in_col;
                self.col_set(above2, below2);
                self.col_set(above1, e2);
                self.elements[e2].next_in_col = below1;
            }
            self.elements[e2].row = row1;
        }
    }

    /// `ExchangeRowElements`: the row-list mirror of the above.
    fn exchange_row_elements(
        &mut self,
        col1: usize,
        e1: usize,
        col2: usize,
        e2: usize,
        row: usize,
    ) {
        let mut left1 = Slot::Head(row);
        let mut p = self.row_get(left1);
        while self.elements[p].col < col1 {
            left1 = Slot::After(p);
            p = self.row_get(left1);
        }
        if e1 != NONE {
            let right1 = self.elements[e1].next_in_row;
            if e2 == NONE {
                if right1 != NONE && self.elements[right1].col < col2 {
                    self.row_set(left1, right1);
                    let mut p = right1;
                    let mut left2;
                    loop {
                        left2 = Slot::After(p);
                        p = self.row_get(left2);
                        if !(p != NONE && self.elements[p].col < col2) {
                            break;
                        }
                    }
                    self.row_set(left2, e1);
                    self.elements[e1].next_in_row = p;
                    self.row_set(left1, right1);
                }
                self.elements[e1].col = col2;
            } else {
                if self.elements[right1].col == col2 {
                    self.elements[e1].next_in_row = self.elements[e2].next_in_row;
                    self.elements[e2].next_in_row = e1;
                    self.row_set(left1, e2);
                } else {
                    let mut p = right1;
                    let mut left2;
                    loop {
                        left2 = Slot::After(p);
                        p = self.row_get(left2);
                        if self.elements[p].col >= col2 {
                            break;
                        }
                    }
                    let right2 = self.elements[e2].next_in_row;
                    self.row_set(left1, e2);
                    self.elements[e2].next_in_row = right1;
                    self.row_set(left2, e1);
                    self.elements[e1].next_in_row = right2;
                }
                self.elements[e1].col = col2;
                self.elements[e2].col = col1;
            }
        } else {
            let right1 = p;
            if self.elements[right1].col != col2 {
                let mut left2;
                loop {
                    left2 = Slot::After(p);
                    p = self.row_get(left2);
                    if self.elements[p].col >= col2 {
                        break;
                    }
                }
                let right2 = self.elements[e2].next_in_row;
                self.row_set(left2, right2);
                self.row_set(left1, e2);
                self.elements[e2].next_in_row = right1;
            }
            self.elements[e2].col = col1;
        }
    }

    /// `RealRowColElimination` / `ComplexRowColElimination`.
    fn row_col_elimination(&mut self, pivot: usize) {
        if self.elements[pivot].value.mag() == 0.0 {
            let row = self.elements[pivot].row;
            self.matrix_is_singular(row);
            return;
        }
        let inverse = self.elements[pivot].value.recip();
        self.elements[pivot].value = inverse;
        let mut upper = self.elements[pivot].next_in_row;
        while upper != NONE {
            let u = self.elements[upper].value.mul(inverse);
            self.elements[upper].value = u;
            let upper_col = self.elements[upper].col;
            let mut sub = self.elements[upper].next_in_col;
            let mut lower = self.elements[pivot].next_in_col;
            while lower != NONE {
                let row = self.elements[lower].row;
                while sub != NONE && self.elements[sub].row < row {
                    sub = self.elements[sub].next_in_col;
                }
                if sub == NONE || self.elements[sub].row > row {
                    sub = self.create_fillin(row, upper_col);
                }
                let l = self.elements[lower].value;
                self.elements[sub].value = self.elements[sub].value.mul_sub(u, l);
                sub = self.elements[sub].next_in_col;
                lower = self.elements[lower].next_in_col;
            }
            upper = self.elements[upper].next_in_row;
        }
    }

    /// `UpdateMarkowitzNumbers`.
    fn update_markowitz_numbers(&mut self, pivot: usize) {
        let mut e = self.elements[pivot].next_in_col;
        while e != NONE {
            let row = self.elements[e].row;
            self.markowitz_row[row] -= 1;
            self.markowitz_prod[row] = self.product_of(row);
            if self.markowitz_row[row] == 0 {
                self.singletons += 1;
            }
            e = self.elements[e].next_in_col;
        }
        let mut e = self.elements[pivot].next_in_row;
        while e != NONE {
            let col = self.elements[e].col;
            self.markowitz_col[col] -= 1;
            self.markowitz_prod[col] = self.product_of(col);
            if self.markowitz_col[col] == 0 && self.markowitz_row[col] != 0 {
                self.singletons += 1;
            }
            e = self.elements[e].next_in_row;
        }
    }

    /// `CreateFillin`.
    fn create_fillin(&mut self, row: usize, col: usize) -> usize {
        let mut above = Slot::Head(col);
        let mut e = self.col_get(above);
        while e != NONE && self.elements[e].row < row {
            above = Slot::After(e);
            e = self.col_get(above);
        }
        let element = self.create_element(row, col, above, true);
        self.markowitz_row[row] += 1;
        self.markowitz_prod[row] = self.product_of(row);
        if self.markowitz_row[row] == 1 && self.markowitz_col[row] != 0 {
            self.singletons -= 1;
        }
        self.markowitz_col[col] += 1;
        self.markowitz_prod[col] = self.product_of(col);
        if self.markowitz_row[col] != 0 && self.markowitz_col[col] == 1 {
            self.singletons -= 1;
        }
        element
    }

    /// `MatrixIsSingular`.
    fn matrix_is_singular(&mut self, step: usize) -> Status {
        self.singular_row = self.int_to_ext_row[step];
        self.singular_col = self.int_to_ext_col[step];
        self.status = Status::Singular;
        self.status
    }

    /// `ZeroPivot`.
    fn zero_pivot(&mut self, step: usize) -> Status {
        self.singular_row = self.int_to_ext_row[step];
        self.singular_col = self.int_to_ext_col[step];
        self.status = Status::ZeroDiag;
        self.status
    }

    // --- spsolve.c ------------------------------------------------------

    /// `spSolve` on a factored matrix. `rhs` and the result are indexed by
    /// external index minus one.
    pub(crate) fn solve(&self, rhs: &[T]) -> Vec<T> {
        debug_assert!(self.factored && rhs.len() == self.size);
        let size = self.size;
        let mut x = vec![T::ZERO; size + 1];
        for i in (1..=size).rev() {
            x[i] = rhs[self.int_to_ext_row[i] - 1];
        }
        for i in 1..=size {
            let mut temp = x[i];
            if !temp.is_zero() {
                let pivot = self.diag[i];
                temp = temp.mul(self.elements[pivot].value);
                x[i] = temp;
                let mut e = self.elements[pivot].next_in_col;
                while e != NONE {
                    let r = self.elements[e].row;
                    x[r] = x[r].mul_sub(temp, self.elements[e].value);
                    e = self.elements[e].next_in_col;
                }
            }
        }
        for i in (1..=size).rev() {
            let mut temp = x[i];
            let mut e = self.elements[self.diag[i]].next_in_row;
            while e != NONE {
                temp = temp.mul_sub(self.elements[e].value, x[self.elements[e].col]);
                e = self.elements[e].next_in_row;
            }
            x[i] = temp;
        }
        let mut solution = vec![T::ZERO; size];
        for i in (1..=size).rev() {
            solution[self.int_to_ext_col[i] - 1] = x[i];
        }
        solution
    }

    /// `spSolveTransposed`: `A^T x = b` with the same factors.
    pub(crate) fn solve_transposed(&self, rhs: &[T]) -> Vec<T> {
        debug_assert!(self.factored && rhs.len() == self.size);
        let size = self.size;
        let mut x = vec![T::ZERO; size + 1];
        for i in (1..=size).rev() {
            x[i] = rhs[self.int_to_ext_col[i] - 1];
        }
        for i in 1..=size {
            let temp = x[i];
            if !temp.is_zero() {
                let mut e = self.elements[self.diag[i]].next_in_row;
                while e != NONE {
                    let c = self.elements[e].col;
                    x[c] = x[c].mul_sub(temp, self.elements[e].value);
                    e = self.elements[e].next_in_row;
                }
            }
        }
        for i in (1..=size).rev() {
            let pivot = self.diag[i];
            let mut temp = x[i];
            let mut e = self.elements[pivot].next_in_col;
            while e != NONE {
                temp = temp.mul_sub(x[self.elements[e].row], self.elements[e].value);
                e = self.elements[e].next_in_col;
            }
            x[i] = temp.mul(self.elements[pivot].value);
        }
        let mut solution = vec![T::ZERO; size];
        for i in (1..=size).rev() {
            solution[self.int_to_ext_row[i] - 1] = x[i];
        }
        solution
    }
}

/// Scalar operations used only by [`Sparse::determinant`].
pub(crate) trait DeterminantScale: Scalar {
    /// One.
    fn one() -> Self;
    /// C's per-pivot update: real `det /= diag` (diag holds `1/pivot`), complex
    /// `det *= CMPLX_RECIPROCAL(diag)`.
    fn det_step(det: Self, inverse_pivot: Self) -> Self;
    /// `NORM`: `max(|re|, |im|)` (real: `|x|`).
    fn norm(self) -> f64;
    /// Multiply by a real factor.
    fn scale(self, factor: f64) -> Self;
}

impl DeterminantScale for f64 {
    fn one() -> Self {
        1.0
    }
    fn det_step(det: Self, inverse_pivot: Self) -> Self {
        det / inverse_pivot
    }
    fn norm(self) -> f64 {
        self.abs()
    }
    fn scale(self, factor: f64) -> Self {
        self * factor
    }
}

impl DeterminantScale for Complex {
    fn one() -> Self {
        Complex::real(1.0)
    }
    fn det_step(det: Self, inverse_pivot: Self) -> Self {
        // CMPLX_MULT_ASSIGN(det, reciprocal).
        det.mul(inverse_pivot.recip())
    }
    fn norm(self) -> f64 {
        self.re.abs().max(self.im.abs())
    }
    fn scale(self, factor: f64) -> Self {
        Complex::new(self.re * factor, self.im * factor)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    fn build(n: usize, entries: &[(usize, usize, f64)]) -> Sparse<f64> {
        let mut m = Sparse::new(n);
        for &(r, c, v) in entries {
            let e = m.get_element(r, c);
            m.add(e, v);
        }
        m
    }

    fn residual(entries: &[(usize, usize, f64)], x: &[f64], b: &[f64]) -> f64 {
        let mut ax = vec![0.0; b.len()];
        for &(r, c, v) in entries {
            ax[r - 1] += v * x[c - 1];
        }
        ax.iter()
            .zip(b)
            .map(|(a, b)| (a - b).abs())
            .fold(0.0, f64::max)
    }

    #[test]
    fn solves_with_pivoting_and_mna_twins() {
        // Voltage source branch (row/col 3) with zero diagonal.
        let entries = [
            (1, 1, 1e-3),
            (1, 2, -1e-3),
            (2, 1, -1e-3),
            (2, 2, 3e-3),
            (1, 3, 1.0),
            (3, 1, 1.0),
        ];
        let mut m = build(3, &entries);
        m.mna_preorder();
        assert_eq!(m.order_and_factor(1e-3, 1e-13), Status::Okay);
        let b = [0.0, 0.0, 5.0];
        let x = m.solve(&b);
        assert!(residual(&entries, &x, &b) < 1e-12, "{x:?}");
        let xt = m.solve_transposed(&b);
        let transposed: Vec<_> = entries.iter().map(|&(r, c, v)| (c, r, v)).collect();
        assert!(residual(&transposed, &xt, &b) < 1e-12, "{xt:?}");
    }

    #[test]
    fn refactor_reuses_pivots_and_detects_zero_diagonal() {
        let entries = [(1, 1, 2.0), (1, 2, 1.0), (2, 1, 1.0), (2, 2, 3.0)];
        let mut m = build(2, &entries);
        assert_eq!(m.order_and_factor(1e-3, 0.0), Status::Okay);
        let handles: Vec<_> = entries
            .iter()
            .map(|&(r, c, _)| m.get_element(r, c))
            .collect();
        m.clear();
        for (h, v) in handles.iter().zip([4.0, 1.0, 1.0, 5.0]) {
            m.set(*h, v);
        }
        assert_eq!(m.factor(), Status::Okay);
        let x = m.solve(&[5.0, 6.0]);
        assert!((4.0 * x[0] + x[1] - 5.0).abs() < 1e-14);
        m.clear();
        assert_eq!(m.factor(), Status::ZeroDiag);
    }

    #[test]
    fn singular_and_determinant() {
        let mut m = build(2, &[(1, 1, 1.0), (1, 2, 2.0), (2, 1, 2.0), (2, 2, 4.0)]);
        assert_eq!(m.order_and_factor(1e-3, 0.0), Status::Singular);
        let mut m = build(2, &[(1, 1, 3.0), (1, 2, 1.0), (2, 1, 2.0), (2, 2, 4.0)]);
        assert_eq!(m.order_and_factor(1e-3, 0.0), Status::Okay);
        let (mantissa, exponent) = m.determinant();
        assert!((mantissa * 10f64.powi(exponent) - 10.0).abs() < 1e-12);
    }

    #[test]
    fn complex_solve_matches_product() {
        let entries = [
            (1, 1, Complex::new(1.0, 2.0)),
            (1, 2, Complex::new(0.0, -1.0)),
            (2, 1, Complex::new(0.0, -1.0)),
            (2, 2, Complex::new(2.0, 0.5)),
        ];
        let mut m: Sparse<Complex> = Sparse::new(2);
        for &(r, c, v) in &entries {
            let e = m.get_element(r, c);
            m.add(e, v);
        }
        assert_eq!(m.order_and_factor(1e-3, 0.0), Status::Okay);
        let b = [Complex::real(1.0), Complex::new(0.0, 1.0)];
        let x = m.solve(&b);
        for row in 1..=2 {
            let mut sum = Complex::ZERO;
            for &(r, c, v) in &entries {
                if r == row {
                    sum = sum + v * x[c - 1];
                }
            }
            assert!((sum - b[row - 1]).magnitude() < 1e-14);
        }
    }

    #[test]
    fn larger_ladder_fills_and_solves() {
        let n = 200;
        let mut entries = Vec::new();
        for i in 1..=n {
            entries.push((i, i, 2.0 + 1e-3 * i as f64));
            if i > 1 {
                entries.push((i, i - 1, -1.0));
                entries.push((i - 1, i, -1.0));
            }
        }
        entries.push((1, n, 0.5));
        entries.push((n, 1, 0.25));
        let mut m = build(n, &entries);
        assert_eq!(m.order_and_factor(1e-3, 1e-13), Status::Okay);
        let b: Vec<_> = (0..n).map(|i| (i as f64).sin()).collect();
        let x = m.solve(&b);
        assert!(residual(&entries, &x, &b) < 1e-10);
    }
}
